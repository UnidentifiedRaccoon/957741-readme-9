{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@project/account-config": ["libs/account/config/src/index.ts"],
      "@project/authentication": ["libs/account/authentication/src/index.ts"],
      "@project/blog-user": ["libs/account/blog-user/src/index.ts"],
      "@project/config": ["libs/account/config/src/index.ts"],
      "@project/content-config": ["libs/content/config/src/index.ts"],
      "@project/content-models": ["libs/content/models/src/index.ts"],
      "@project/content-post": ["libs/content/post/src/index.ts"],
      "@project/content-tag": ["libs/content/tag/src/index.ts"],
      "@project/content-post-api": ["libs/content/post-api/src/index.ts"],
      "@project/core": ["libs/shared/core/src/index.ts"],
      "@project/data-access": ["libs/shared/data-access/src/index.ts"],
      "@project/helpers": ["libs/shared/helpers/src/index.ts"],
      "@project/engage-config": ["libs/engage/config/src/index.ts"],
      "@project/engage-like": ["libs/engage/like/src/index.ts"],
      "@project/engage-comment": ["libs/engage/comment/src/index.ts"],
      "@project/engage-subscription": ["libs/engage/subscription/src/index.ts"],
      "@project/engage-like-api": ["libs/engage/like-api/src/index.ts"],
      "@project/engage-comment-api": ["libs/engage/comment-api/src/index.ts"],
      "@project/engage-subscription-api": ["libs/engage/subscription-api/src/index.ts"],
      "@project/engage-models": ["libs/engage/models/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
