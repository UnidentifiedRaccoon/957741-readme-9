# Create a new user
POST http://localhost:3000/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "dateBirth": "2012-02-22",
  "firstname": "Keks",
  "lastname": "Smith",
  "password": "123456"
}

###

# Login user by email and password
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "password": "123456"
}

###

# Get user by ID (replace with actual user ID after registration)
GET http://localhost:3000/api/auth/user/d2258182-2d62-410d-a8cd-dcdd67886c9b HTTP/1.1

###

# Test: Try to register user with existing email (should fail with 409 Conflict)
POST http://localhost:3000/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "dateBirth": "1990-05-15",
  "firstname": "John",
  "lastname": "Doe",
  "password": "password123"
}

###

# Test: Try to login with wrong password (should fail with 401 Unauthorized)
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "password": "wrongpassword"
}

###

# Test: Try to login with non-existing email (should fail with 404 Not Found)
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "123456"
}

###

# Test: Try to get non-existing user (should fail with 404 Not Found)
GET http://localhost:3000/api/auth/user/00000000-0000-0000-0000-000000000000 HTTP/1.1

###

# Register another user
POST http://localhost:3000/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "alice@example.com",
  "dateBirth": "1995-08-20",
  "firstname": "Alice",
  "lastname": "Johnson",
  "password": "secure123"
}

###

# Login with the second user
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "secure123"
}

