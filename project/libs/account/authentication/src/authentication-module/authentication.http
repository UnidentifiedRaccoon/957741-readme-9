# User 3: bob@example.com / password123 - ID: 6581762309c030b503e30513
# =============================================

###

# Login with seeded user (user@notfound.local)
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "password": "123456"
}

###

# Get seeded user by ID (Keks Smith)
GET http://localhost:3000/api/auth/user/658170cbb954e9f5b905ccf4 HTTP/1.1

###

