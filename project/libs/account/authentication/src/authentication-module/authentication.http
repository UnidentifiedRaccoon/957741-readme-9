# =============================================
# Registration Tests
# =============================================

# Register a new user
POST http://localhost:3000/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "newuser@example.com",
  "dateBirth": "1990-05-15",
  "firstname": "New",
  "lastname": "User",
  "password": "newpassword"
}

###

# Test: Try to register user with existing email (should fail with 409 Conflict)
POST http://localhost:3000/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "dateBirth": "1990-05-15",
  "firstname": "John",
  "lastname": "Doe",
  "password": "password123"
}

###

# =============================================
# Error Cases
# =============================================

# Test: Try to login with wrong password (should fail with 401 Unauthorized)
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "user@notfound.local",
  "password": "wrongpassword"
}

###

# Test: Try to login with non-existing email (should fail with 404 Not Found)
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "123456"
}

###

# Test: Try to get non-existing user (should fail with 404 Not Found)
GET http://localhost:3000/api/auth/user/000000000000000000000000 HTTP/1.1

###

