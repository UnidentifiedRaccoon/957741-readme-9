# Application
NODE_ENV=development
PORT=3004

# Docker Compose (for RabbitMQ container)
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=test

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27019
MONGO_DB=readme-notify
MONGO_USER=admin
MONGO_PASSWORD=test
MONGO_AUTH_BASE=admin

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PASSWORD=test
RABBIT_PORT=5672
RABBIT_USER=admin
RABBIT_QUEUE=readme.notify.income
RABBIT_EXCHANGE=readme.notify.income

# SMTP (Fake SMTP Server)
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=8025
MAIL_USER_NAME=admin
MAIL_USER_PASSWORD=test
MAIL_FROM=noreply@readme.local

# Content Service
CONTENT_SERVICE_URL=http://localhost:3002